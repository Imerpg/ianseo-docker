# ============================================================
#  Ianseo
# ============================================================

# Version à installer (format YYYYMMDD, obligatoire)
IANSEO_VERSION=20250210

WEB_PORT=80

# ============================================================
#  Base de données (obligatoire)
# ============================================================
MYSQL_USER=ianseo
MYSQL_PASSWORD=ianseo
MYSQL_ROOT_PASSWORD=ianseo_root
MYSQL_DATABASE=ianseo

# Optionnel : nom du service/conteneur MySQL (défaut : ianseo-install-db-1)
# DB_HOST=ianseo-install-db-1

# ============================================================
#  Mise à jour automatique d'Ianseo
# ============================================================
IANSEO_URL=http://localhost/ianseo/Update/index-action.php

# Pour les dev Ianseo
# IANSEO_UPDATE_USER=
# IANSEO_UPDATE_PASS=

# 1 pour forcer la mise à jour même si la version est identique
# IANSEO_UPDATE_FORCE=0

# ============================================================
#  Modules Custom (IanseoModules)
# ============================================================
# all = tous les modules | none = aucun | GUIDE = un seul module

# Modules disponibles (valeurs possibles pour IANSEO_MODULES) et leur README :
#   AUTH                  Multi-comptes & inscriptions en ligne
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/AUTH/README_AUTH.md
#   AUTO_SEND             Envoi automatique
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/AUTO_SEND/README_AUTO_SEND_FR.md
#   EXPORT_LISTE          Export CSV des participants
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/EXPORT_LISTE/README_EXPORT_LISTE.md
#   GUIDE                 Guide interactif
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/GUIDE/README_GUIDE.md
#   POULES                Poules, vue commentateur
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/POULES/README_POULES.md
#   PRONO                 Pronostics en direct
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/PRONO/README_PRONO.md
#   REPARTITION_EPREUVES  Répartition des épreuves
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/REPARTITION_EPREUVES/README_REPARTITION_EPREUVES.md
#   SCORECARD_SPLITTER    Feuilles de marque par club ou archer
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/SCORECARD_SPLITTER/README_SCORECARD_SPLITTER_FR.md
#   SELEC                 Sélection Équipe de France
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/SELEC/README_SELEC.md
#   SYNCHRO_FFTA          Passerelle extranet FFTA
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/SYNCHRO_FFTA/README_SYNCHRO_FFTA.md
#   THEME                 Thème (mode sombre et couleurs)
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/THEME/README_THEME_FR.md
#   TIRAGE                Tirage au sort en direct
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/TIRAGE/README_TIRAGE_FR.md
#   TNM                   Trophée National des Mixtes
#                         https://github.com/Steph-Krs/IanseoModules/blob/main/TNM/README_TNM.md
IANSEO_MODULES=all

# Langue de l'installeur : en | fr
IANSEO_MODULES_LANG=fr